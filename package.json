{
  "name": "cursed-domain-godot-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "audit:pm-v2": "tsx ../godot-backend-tools/pm-audit-cli.ts",
    "plan:pm-v2-balance": "tsx ../godot-backend-tools/pm-balance-planner-cli.ts",
    "apply:pm-v2-balance": "tsx ../godot-backend-tools/pm-balance-apply-cli.ts --write",
    "snapshot:pm-v2-phase7": "tsx ../godot-backend-tools/pm-phase7-snapshot-cli.ts --write",
    "calibrate:pm-v2-thresholds": "tsx ../godot-backend-tools/pm-threshold-calibration-cli.ts --write",
    "plan:pm-v2-hero-targets": "tsx ../godot-backend-tools/pm-hero-balance-planner-cli.ts",
    "apply:pm-v2-hero-targets": "tsx ../godot-backend-tools/pm-hero-balance-apply-cli.ts --write",
    "apply:pm-v2-specializations": "tsx ../godot-backend-tools/pm-hero-specialization-apply-cli.ts --write",
    "activate:pm-v2": "tsx ../godot-backend-tools/pm-v2-cutover-apply-cli.ts --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.1",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.5",
    "hono": "^4.6.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
