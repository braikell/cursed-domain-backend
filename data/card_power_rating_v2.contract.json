{
  "schemaVersion": 1,
  "contractId": "card-pm-v2-statistical",
  "status": "active",
  "runtimeEnabled": true,
  "scope": {
    "name": "STATISTICAL_POWER",
    "levelOneCalibration": true,
    "includes": [
      "ad",
      "ap",
      "hp",
      "attackSpeedMultiplier",
      "scaling",
      "role",
      "rarity",
      "cardType",
      "critChance",
      "critDamageMultiplier"
    ],
    "excludes": [
      "ultimate",
      "summons",
      "healing",
      "shields",
      "buffs",
      "debuffs",
      "targetCount",
      "movementSpeed",
      "attackRange",
      "position"
    ]
  },
  "constants": {
    "referencePm": 600,
    "baseAttackIntervalSeconds": 1.45,
    "defaultCritChance": 0.08,
    "defaultCritDamageMultiplier": 1.5,
    "minimumAttackSpeedMultiplier": 0.7,
    "maximumAttackSpeedMultiplier": 1.2,
    "balanceTolerance": 0.03
  },
  "attackPower": {
    "PHYSICAL": "ad",
    "MAGICAL": "ap",
    "HYBRID": "(ad + ap) / 2",
    "SUPPORT": "explicitBasicAttackPower"
  },
  "formula": {
    "expectedCritMultiplier": "1 + critChance * (critDamageMultiplier - 1)",
    "basicDps": "attackPower * attackSpeedMultiplier / baseAttackIntervalSeconds * expectedCritMultiplier",
    "offenseIndex": "basicDps / role.referenceBasicDps",
    "survivalIndex": "hp / role.referenceHp",
    "statisticalPowerIndex": "role.offenseWeight * offenseIndex + role.survivalWeight * survivalIndex",
    "pm": "round(referencePm * statisticalPowerIndex)"
  },
  "roleProfiles": {
