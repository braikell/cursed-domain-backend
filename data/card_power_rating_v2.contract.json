  "rules": {
    "rarityIsNotAppliedInsidePmFormula": true,
    "rarityDefinesBalanceTargetOnly": true,
    "rarityOrderingAppliesAtEqualProgression": true,
    "rarityOrderingScope": "within_card_type",
    "individualHeroTargetsAreAuthoritative": true,
    "unknownRoleIsError": true,
    "unknownScalingIsError": true,
